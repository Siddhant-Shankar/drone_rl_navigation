<?xml version="1.0"?>
<package format="2">
  <name>drone_rl_navigation</name>
  <version>1.0.0</version>
  <description>3D path visualization and RL-based drone navigation</description>
  
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  
  <depend>rospy</depend>
  <depend>std_msgs</depend>
